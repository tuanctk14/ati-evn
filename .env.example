# =============================================================================
# ATI-EVN — Environment Configuration
# Copy to .env and fill values. NEVER commit .env.
# =============================================================================

# -- Database -----------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ati_evn
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ati_evn

# LLM Provider: 9Router (DeepSeek)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.codexhub.click/v1
LLM_MODEL=deepseek-v4-flash
LLM_PROVIDER=9router

# -- CVE feeds ----------------------------------------------------------------
NVD_API_KEY=
# NVD — https://services.nvd.nist.gov (50 req/30s with key vs 5 without)
VULNERS_API_KEY=
# Vulners — aggregator DB, good for vendor/product/CPE inference

# -- abuse.ch (ThreatFox, MalwareBazaar, URLhaus, Feodo) ----------------------
# Since ~2024, ALL abuse.ch APIs REQUIRE Auth-Key header.
# One key works across all 4 platforms. Get free at https://auth.abuse.ch/
ABUSE_CH_AUTH_KEY=

# -- Other IOC feeds ----------------------------------------------------------
OTX_API_KEY=
URLSCAN_API_KEY=
PULSEDIVE_API_KEY=
GITHUB_TOKEN=
LEAKCHECK_API_KEY=

# -- Attack surface discovery -------------------------------------------------
CENSYS_API_KEY=
LEAKIX_API_KEY=
GRAYHATWARFARE_API_KEY=

# -- Enrichment ---------------------------------------------------------------
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# -- Telegram bot -------------------------------------------------------------
# Bot token from @BotFather. Chat ID = the single team chat where alerts go.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
# Comma-separated Telegram user_ids allowed to run commands (analyst allowlist)
TELEGRAM_ALLOWED_USER_IDS=

# -- Runtime ------------------------------------------------------------------
LOG_LEVEL=INFO
USER_AGENT=ATI-EVN/0.1 (+security-research)
HTTP_TIMEOUT_SECONDS=30
