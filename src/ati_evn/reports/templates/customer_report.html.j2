<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<title>ATI-EVN Report — {{ meta.customer.name }} — {{ meta.from_dt[:10] }} to {{ meta.to_dt[:10] }}</title>
<style>
  @page { size: A4; margin: 1.5cm; }
  body { font-family: 'Noto Sans', 'Segoe UI', Arial, sans-serif;
         font-size: 11pt; color: #222; line-height: 1.5; }
  h1 { color: #003366; border-bottom: 3px solid #003366; padding-bottom: 8px; }
  h2 { color: #003366; margin-top: 24px;
         border-bottom: 1px solid #999; padding-bottom: 4px; }
  h3 { color: #555; margin-top: 12px; }
  .header-block { background: #f0f4f8; padding: 12px;
                    border-left: 4px solid #003366; margin-bottom: 20px; }
  .header-block p { margin: 4px 0; }
  .narrative { background: #fffaf0; padding: 14px;
                 border-left: 4px solid #e67e22;
                 margin: 12px 0; white-space: pre-wrap; font-size: 10.5pt; }
  table { width: 100%; border-collapse: collapse; margin: 8px 0;
            font-size: 9.5pt; }
  th, td { border: 1px solid #ddd; padding: 6px 8px; text-align: left;
             vertical-align: top; }
  th { background: #e0e8ef; }
  .sev-CRITICAL { color: #c0392b; font-weight: bold; }
  .sev-HIGH { color: #e67e22; font-weight: bold; }
  .sev-MEDIUM { color: #d4ac0d; }
  .sev-LOW { color: #27ae60; }
  .kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr);
                gap: 10px; margin: 10px 0; }
  .kpi { text-align: center; padding: 10px; border: 1px solid #ddd;
            background: #f8f9fa; }
  .kpi .num { font-size: 20pt; font-weight: bold; color: #003366; }
  .kpi .label { font-size: 9pt; color: #666; }
  .note-na { background: #fdf2f2; padding: 10px;
               border-left: 3px solid #c0392b; margin: 10px 0; font-size: 10pt; }
  .all-clear { background: #eafaf1; padding: 14px;
                 border-left: 4px solid #27ae60; margin: 12px 0;
                 text-align: center; font-size: 12pt; }
  .footer { margin-top: 30px; padding-top: 10px;
              border-top: 1px solid #999; font-size: 8pt; color: #999; }
  code { background: #f0f0f0; padding: 1px 4px; font-size: 9pt; }
  .kev-badge { background: #c0392b; color: white; padding: 2px 6px;
                 border-radius: 3px; font-size: 8pt; font-weight: bold; }
  .epss-high { color: #e67e22; font-weight: bold; }
  .cve-detail { border-left: 3px solid #003366; padding: 8px 12px;
                  background: #fafbfc; margin: 6px 0; font-size: 10pt; }
  .cve-detail h4 { margin: 0 0 4px; color: #003366; font-size: 11pt; }
  .cve-refs { font-size: 8.5pt; color: #666; margin-top: 4px; }
  .service-agg-table td { padding: 5px 8px; }
</style>
</head>
<body>

<h1>ATI-EVN — {{ meta.customer.name }}</h1>

<div class="header-block">
  <p><strong>Customer:</strong> {{ meta.customer.name }}
     {% if meta.customer.short_code %}<em>({{ meta.customer.short_code }})</em>{% endif %}</p>
  {% if meta.customer.primary_domain %}
  <p><strong>Primary domain:</strong> <code>{{ meta.customer.primary_domain }}</code></p>
  {% endif %}
  <p><strong>Kỳ báo cáo:</strong>
     {{ meta.from_dt[:10] }} → {{ meta.to_dt[:10] }}
     ({{ meta.window_days }} ngày)</p>
  <p><strong>Tạo lúc:</strong> {{ meta.generated_at[:19] }} UTC</p>
</div>

{% if findings.total == 0 and exposures.in_window == 0
      and document_leaks.in_window == 0 and brand_abuse.in_window == 0 %}
<div class="all-clear">
  ✓ Không phát hiện threat nào cho {{ meta.customer.name }} trong kỳ báo cáo.
  Duy trì baseline monitoring.
</div>
{% endif %}

<h2>Executive Summary</h2>
<div class="narrative">{{ narrative }}</div>

<div class="kpi-grid">
  <div class="kpi">
    <div class="num">{{ findings.total }}</div>
    <div class="label">Findings mới</div>
  </div>
  <div class="kpi">
    <div class="num">{{ findings.by_severity.CRITICAL | default(0) }}</div>
    <div class="label">CRITICAL</div>
  </div>
  <div class="kpi">
    <div class="num">{{ exposures.total_active }}</div>
    <div class="label">Exposure active</div>
  </div>
  <div class="kpi">
    <div class="num">{{ malicious_ips.total }}</div>
    <div class="label">IP risk ≥ 40</div>
  </div>
</div>

<h2>1. Findings</h2>
<h3>Phân bố theo severity</h3>
<table>
  <tr><th>Severity</th><th>Số lượng</th></tr>
  {% for sev, cnt in findings.by_severity.items() %}
  <tr><td class="sev-{{ sev }}">{{ sev }}</td><td>{{ cnt }}</td></tr>
  {% endfor %}
</table>

{% if findings.by_source %}
<h3>Nguồn phát hiện</h3>
<table>
  <tr><th>Source</th><th>Số lượng</th></tr>
  {% for s in findings.by_source %}
  <tr><td><code>{{ s.source }}</code></td><td>{{ s.count }}</td></tr>
  {% endfor %}
</table>
{% endif %}

{% if findings.top_critical %}
<h3>Top CRITICAL/HIGH finding</h3>
<table>
  <tr>
    <th>ID</th><th>Sev</th><th>Title</th>
    <th>Asset</th><th>IOC</th>
  </tr>
  {% for f in findings.top_critical %}
  <tr>
    <td>{{ f.id }}</td>
    <td class="sev-{{ f.severity }}">{{ f.severity }}</td>
    <td>{{ f.title }}</td>
    <td>{{ f.matched_asset }}</td>
    <td><code>{{ f.ioc_value }}</code></td>
  </tr>
  {% endfor %}
</table>
{% endif %}

<h2>2. Lỗ hổng bảo mật</h2>
<p>Số CVE: <strong>{{ vulnerabilities.total }}</strong>
   {% if cve_enrichment_summary.kev_count > 0 %}
   — <span class="kev-badge">KEV: {{ cve_enrichment_summary.kev_count }}</span>
   {% endif %}
   {% if cve_enrichment_summary.high_epss_count > 0 %}
   — <span class="epss-high">EPSS ≥ 0.7: {{ cve_enrichment_summary.high_epss_count }}</span>
   {% endif %}
</p>
{% if vulnerabilities.findings %}
{% for v in vulnerabilities.findings[:15] %}
<div class="cve-detail">
  <h4>
    {{ v.cve }}
    {% if v.is_kev %}<span class="kev-badge">KEV</span>{% endif %}
    <span class="sev-{{ v.severity }}">[{{ v.severity }}]</span>
  </h4>
  <div>{{ v.title }}</div>
  <div><strong>Asset:</strong> {{ v.asset or "-" }}</div>
  {% if v.epss_score %}
  <div><strong>EPSS:</strong>
       <span {% if v.epss_score >= 0.7 %}class="epss-high"{% endif %}>
         {{ (v.epss_score * 100) | round(1) }}%
         (percentile: {{ v.epss_percentile | round(1) }})
       </span>
  </div>
  {% endif %}
  {% if v.is_kev %}
  <div><strong>KEV info:</strong> {{ v.kev_vendor }} / {{ v.kev_product }}</div>
  <div><strong>Required action:</strong> {{ v.kev_required_action }}</div>
  {% endif %}
  <div class="cve-refs">Refs: <a href="{{ v.nvd_url }}">NVD</a></div>
</div>
{% endfor %}
{% if vulnerabilities.findings | length > 15 %}
<p><em>...và {{ vulnerabilities.findings | length - 15 }} CVE khác.</em></p>
{% endif %}
{% else %}
<p><em>Không có CVE finding trong kỳ.</em></p>
{% endif %}

<h2>2B. Raw Threat Indicators</h2>
<p>Tổng số raw IOC (IP, domain, URL, hash) của customer này trong kỳ: <strong>{{ raw_indicators.total }}</strong></p>

{% if raw_indicators.by_type %}
<table>
  <tr><th>Type</th><th>Count</th></tr>
  {% for tp, cnt in raw_indicators.by_type.items() %}
  <tr><td><code>{{ tp }}</code></td><td>{{ cnt }}</td></tr>
  {% endfor %}
</table>
{% endif %}

{% if raw_indicators.top_unack %}
<h3>Top raw IOC severity cao chưa acknowledge</h3>
<table>
  <tr>
    <th>ID</th><th>Type</th><th>Sev</th><th>Value</th><th>Sources</th>
  </tr>
  {% for r in raw_indicators.top_unack %}
  <tr>
    <td>{{ r.id }}</td>
    <td>{{ r.type }}</td>
    <td class="sev-{{ r.severity }}">{{ r.severity }}</td>
    <td><code>{{ r.value }}</code></td>
    <td>{{ r.sources | join(", ") }}</td>
  </tr>
  {% endfor %}
</table>
<p><em>Analyst xem chi tiết: /indicator &lt;id&gt;. Acknowledge: /acknowledge_indicator &lt;id&gt;.</em></p>
{% else %}
<p><em>Không có raw IOC severity cao chưa acknowledge trong kỳ.</em></p>
{% endif %}

<h2>3. Chiến dịch tấn công</h2>
{% if campaigns.list %}
<p>{{ campaigns.total }} chiến dịch có liên quan tới customer này.</p>
<table>
  <tr>
    <th>Campaign</th><th>Status</th><th>Confidence</th>
    <th>Shared findings</th><th>Top techniques</th>
  </tr>
  {% for c in campaigns.list %}
  <tr>
    <td>{{ c.name }}</td><td>{{ c.status }}</td>
    <td>{{ c.confidence }}</td><td>{{ c.shared_findings }}</td>
    <td>{{ c.top_techniques | join(", ") }}</td>
  </tr>
  {% endfor %}
</table>
{% else %}
<p><em>Không có chiến dịch nào liên quan customer trong kỳ.</em></p>
{% endif %}

<h2>4. Cổng dịch vụ mở</h2>
<p>Trong kỳ: {{ exposures.in_window }} | Tổng active: {{ exposures.total_active }}</p>
{% if exposures.list %}
<table>
  <tr><th>IP</th><th>Port</th><th>Service</th></tr>
  {% for e in exposures.list %}
  <tr><td>{{ e.ip }}</td><td>{{ e.port }}</td><td>{{ e.service }}</td></tr>
  {% endfor %}
</table>
{% else %}
<p><em>Không có exposure mới trong kỳ.</em></p>
{% endif %}

{% if service_aggregate %}
<h3>Top service bị expose</h3>
<table class="service-agg-table">
  <tr><th>Service</th><th>Exposures</th></tr>
  {% for s in service_aggregate %}
  <tr><td><code>{{ s.service }}</code></td><td>{{ s.count }}</td></tr>
  {% endfor %}
</table>
{% endif %}

<h2>5. Lộ lọt tài liệu</h2>
<p>Trong kỳ: {{ document_leaks.in_window }}</p>
{% if document_leaks.sightings %}
<table>
  <tr>
    <th>File</th><th>Bucket</th><th>Keyword</th><th>Rule</th>
  </tr>
  {% for d in document_leaks.sightings %}
  <tr>
    <td>{{ d.filename }}</td>
    <td><code>{{ d.bucket_url }}</code></td>
    <td>{{ d.keyword }}</td>
    <td>{{ d.rule_matched or "-" }}</td>
  </tr>
  {% endfor %}
</table>
{% else %}
<p><em>Không có document leak mới trong kỳ.</em></p>
{% endif %}

<h2>6. Lạm dụng thương hiệu</h2>
<p>Trong kỳ: {{ brand_abuse.in_window }}</p>
{% if brand_abuse.sightings %}
<table>
  <tr>
    <th>Domain</th><th>Title</th><th>Rule</th>
    <th>Malicious</th><th>urlscan</th>
  </tr>
  {% for b in brand_abuse.sightings %}
  <tr>
    <td>{{ b.page_domain }}</td>
    <td>{{ b.page_title }}</td>
    <td>{{ b.rule_matched or "-" }}</td>
    <td>{{ "Yes" if b.verdict_malicious else "No" }}</td>
    <td><a href="{{ b.urlscan_result }}">Link</a></td>
  </tr>
  {% endfor %}
</table>
{% else %}
<p><em>Không có brand abuse mới trong kỳ.</em></p>
{% endif %}

<h2>7. IP nguy hiểm</h2>
{% if malicious_ips.list %}
<table>
  <tr>
    <th>IP</th><th>Risk</th><th>Confidence</th><th>Coverage</th>
    <th>Consensus</th><th>Providers flagged</th>
  </tr>
  {% for i in malicious_ips.list %}
  <tr>
    <td><code>{{ i.ip }}</code></td>
    <td>{{ i.aggregate_risk_score }}</td>
    <td>{{ (i.confidence_score * 100) | int }}%</td>
    <td>{{ (i.coverage_score * 100) | int }}%</td>
    <td>{{ i.consensus_status or "-" }}</td>
    <td>{{ i.provider_mask or "-" }}</td>
  </tr>
  {% endfor %}
</table>
{% else %}
<p><em>Không có IP nào liên quan customer đạt risk ≥ 40.</em></p>
{% endif %}

<h2>8. Tài sản giám sát</h2>
<p>Tổng: <strong>{{ asset_coverage.total }}</strong> asset</p>
<table>
  <tr><th>Type</th><th>Count</th></tr>
  {% for a in asset_coverage.by_type %}
  <tr><td>{{ a.type }}</td><td>{{ a.count }}</td></tr>
  {% endfor %}
</table>

<h2>9. Lộ lọt tài khoản — Not Available</h2>
<div class="note-na">
  <strong>{{ credential_leaks.status }}</strong><br>
  {{ credential_leaks.note }}
</div>

<h2>10. Asset Risk Overview</h2>
<p>Top asset của {{ meta.customer.name }} xếp theo risk score (severity-weighted).</p>
{% if asset_risk_ranking %}
<table>
  <tr>
    <th>Asset</th><th>Type</th>
    <th>Findings (C/H/M/L)</th><th>Risk score</th>
  </tr>
  {% for a in asset_risk_ranking %}
  <tr>
    <td><code>{{ a.asset_value }}</code></td>
    <td>{{ a.asset_type }}</td>
    <td>
      <span class="sev-CRITICAL">{{ a.critical }}</span> /
      <span class="sev-HIGH">{{ a.high }}</span> /
      <span class="sev-MEDIUM">{{ a.medium }}</span> /
      <span class="sev-LOW">{{ a.low }}</span>
    </td>
    <td><strong>{{ a.risk_score }}</strong>
        {% if a.ip_aggregate_score %}
        <br><small>(+{{ a.ip_aggregate_score }} IP intel)</small>
        {% endif %}
    </td>
  </tr>
  {% endfor %}
</table>
{% else %}
<p><em>Không có asset nào có finding trong kỳ.</em></p>
{% endif %}

<h3>Top Priority Remediations (LLM-generated)</h3>
<div class="narrative">{{ aggregated_remediation }}</div>

<div class="footer">
  Generated by ATI-EVN. Customer report for
  {{ meta.customer.name }} ({{ meta.customer.short_code }}).
  Window: {{ meta.from_dt[:10] }} → {{ meta.to_dt[:10] }}.
  Generated at {{ meta.generated_at[:19] }} UTC.
</div>

</body>
</html>
